{
  "agent_id": "agent-proxysql-01",
  "backup": {
    "path": "/var/backup/mysql",
    "full_path": "/var/backup/mysql-full",
    "incremental_path": "/var/backup/mysql-incremental",
    "interval": "1h",
    "full_every": "7d",
    "ansible_dir": "/home/vishal/ansible",
    "ansible_playbook": "playbooks/operations/recevo-xtrabackup.yml",
    "ansible_user": "vishal"
  },
  "binlog": {
    "interval": "5m",
    "path": "/var/backup/binlog"
  },
  "cleanup": {
    "enabled": false,
    "interval": "1d",
    "rules": [
      {"source": "/var/backup/mysql-full", "dest": "full-backups", "keep": "30d", "monthly_keep": "12mo", "yearly_keep": "forever"},
      {"source": "/var/backup/mysql-incremental", "dest": "backups", "keep": "30d"},
      {"source": "/var/backup/binlog", "dest": "binlogs", "keep": "2h"}
    ]
  },
  "dashboard": {
    "enabled": false,
    "host": "0.0.0.0",
    "port": 8000
  },
  "discovery": {
    "interval": "30s"
  },
  "heartbeat": {
    "interval": "10s",
    "url": ""
  },
  "minio": {
    "enabled": false,
    "access_key": "",
    "secret_key": "",
    "endpoint": "https://minio.ldc.opstree.dev:9000",
    "bucket": "automated-engine-backups",
    "prefix": "agent-percona-mysql",
    "interval": "2m",
    "uploads": [
      {"source": "/var/backup/mysql-full", "dest": "full-backups", "mode": "folders", "delete_after_upload": false},
      {"source": "/var/backup/mysql-incremental", "dest": "backups", "mode": "folders", "delete_after_upload": false},
      {"source": "/var/backup/binlog", "dest": "binlogs", "mode": "files", "delete_after_upload": true}
    ]
  },
  "mysql": {
    "client_file": "/etc/percona-backup/client.cnf",
    "db_hosts": [
      "192.168.8.54",
      "192.168.8.56",
      "192.168.8.57"
    ],
    "mysql_bin": "mysql",
    "mysqlbinlog_bin": "mysqlbinlog",
    "port": 3306
  },
  "restore": {
    "enabled": true,
    "mode": "warm",
    "interval": "1h",
    "target_time": "",
    "target_host": "",
    "target_user": "vishal",
    "target_ssh_key": "/home/vishal/.ssh/id_rsa",
    "target_mysql_root_password": "",
    "target_dir": "/var/restore",
    "ansible_dir": "/home/vishal/ansible",
    "ansible_playbook": "playbooks/operations/recevo-restore.yml",
    "ansible_user": "vishal"
  }
}
